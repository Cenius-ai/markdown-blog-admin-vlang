# Copy this file to `.env` and fill in the real values.
# `.env` is gitignored and should NEVER be committed.
# Values here are placeholders / examples ONLY.

# ─── Required ───

# JWT signing secret for session tokens.
# Generate a fresh one: openssl rand -hex 32
JWT_SECRET=cenius-dev-4f7a2b1e9c3d5f8a

# ─── Optional ───

# App configuration value.
NEXT_RUNTIME=<set in .env>

# Provider: Runtime config
# Docs: Standard runtime configuration; not secret
NODE_ENV=development

# Port the dev server binds to (default: 3000)
PORT=3000
